# ── Servidor ────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Origem(ns) do front-end permitidas no CORS (separe por vírgula).
# A primeira também é usada nos links dos e-mails.
FRONTEND_URL=http://localhost:5173

# ── Banco de dados (PostgreSQL) ─────────────────────────
DATABASE_URL="postgresql://usuario:senha@localhost:5432/picplus?schema=public"

# ── Autenticação ────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Credenciais do administrador criado por `npm run seed`
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@picplus.com.br
ADMIN_PASSWORD=

# ── E-mail (Resend) ─────────────────────────────────────
# Sem a chave, os e-mails são apenas registrados no log (útil em desenvolvimento).
RESEND_API_KEY=
MAIL_FROM="PicPlus <contato@seudominio.com.br>"
# Quem recebe avisos de novos cadastros/contatos (separe por vírgula)
ADMIN_NOTIFY_EMAIL=

# ── Uploads ─────────────────────────────────────────────
# Pasta onde imagens e PDFs são gravados (padrão: ./uploads)
# Em produção aponte para um volume persistente.
UPLOADS_DIR=
