# ── Servidor ────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Origem(ns) do front-end permitidas no CORS (separe por vírgula).
# A primeira também é usada nos links dos e-mails.
FRONTEND_URL=http://localhost:5173
# URL pública deste serviço (usada nos links e no cadastro de webhooks)
BACKEND_URL=http://localhost:3000

# ── Banco de dados (PostgreSQL) ─────────────────────────
DATABASE_URL="postgresql://usuario:senha@localhost:5432/picplus?schema=public"

# ── Autenticação ────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Credenciais do administrador criado por `npm run seed`
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@picplus.com.br
ADMIN_PASSWORD=
# O admin é criado no boot só se não houver nenhum usuário. Para recuperar o acesso (senha
# esquecida/e-mail errado), defina ADMIN_FORCE_RESET=true, reinicie e REMOVA a variável em seguida.
ADMIN_FORCE_RESET=

# ── E-mail (Resend) ─────────────────────────────────────
# Sem a chave, os e-mails são apenas registrados no log (útil em desenvolvimento).
RESEND_API_KEY=
# Segredo de assinatura do webhook do Resend (whsec_...) para registrar entrega/abertura/bounces
RESEND_WEBHOOK_SECRET=
MAIL_FROM="PicPlus <contato@seudominio.com.br>"
# Quem recebe avisos de novos cadastros/contatos (separe por vírgula)
ADMIN_NOTIFY_EMAIL=

# ── Uploads ─────────────────────────────────────────────
# Produção: Cloudflare R2. Preencha TODAS as cinco variáveis (parcial = erro na inicialização).
# Deixe todas vazias em desenvolvimento para gravar em disco (./uploads).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Só no modo disco: pasta dos arquivos (padrão: ./uploads)
UPLOADS_DIR=

# ── Mercado Pago (PicPlus Academy) ──────────────────────
# Painel: https://www.mercadopago.com.br/developers/panel/app → sua aplicação (Checkout Pro)
#  - MP_ACCESS_TOKEN: credenciais de produção (APP_USR-...) ou de teste, em "Credenciais".
#  - MP_WEBHOOK_SECRET: Webhooks > Configurar notificações > "Assinatura secreta".
#    URL a cadastrar (evento "Pagamentos"): <BACKEND_URL>/api/academy/webhooks/mercadopago
# Em produção BACKEND_URL e FRONTEND_URL precisam ser HTTPS públicos. Sem MP_ACCESS_TOKEN
# o checkout só funciona simulado, e apenas com NODE_ENV diferente de production.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ── Asaas v3 (Gestão de Clientes e Cobranças) ───────────
# Sem a chave, o sistema opera em modo de simulação no desenvolvimento.
# Para testar em sandbox: https://sandbox.asaas.com
ASAAS_API_KEY=
ASAAS_SANDBOX=true
# Token secreto criado para o webhook no Asaas (não é a API key)
ASAAS_WEBHOOK_SECRET=

# Configurações Fiscais Padrão para emissão de NFS-e via Asaas:
# retainIss: true se o ISS for retido pelo cliente (tomador), false se recolhido por você (padrão)
ASAAS_TAX_RETAIN_ISS=false
# Alíquotas percentuais (ex: 2 para 2%). Para empresas no Simples Nacional, manter 0 (recolhimento unificado no DAS).
ASAAS_TAX_ISS=0
ASAAS_TAX_COFINS=0
ASAAS_TAX_CSLL=0
ASAAS_TAX_INSS=0
ASAAS_TAX_IR=0
ASAAS_TAX_PIS=0
# Opcional: código ou ID do serviço municipal (caso a sua conta no Asaas exija na emissão)
ASAAS_MUNICIPAL_SERVICE_ID=
ASAAS_MUNICIPAL_SERVICE_CODE=
ASAAS_MUNICIPAL_SERVICE_NAME=
