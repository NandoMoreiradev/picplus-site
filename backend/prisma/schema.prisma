// PicPlus — schema do banco de dados (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Administração
// ─────────────────────────────────────────────────────────────

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String
  // Proprietário: tem todas as permissões, independentemente do cargo, e não pode ficar sem ninguém.
  isOwner   Boolean   @default(false)
  // Usuário desativado não consegue entrar e tem a sessão invalidada.
  active    Boolean   @default(true)
  role      Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  roleId    String?
  articles  Article[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([roleId])
}

// Cargo = conjunto de permissões no formato "recurso.acao" (ver src/access/permissions.ts).
model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Influenciadores (cadastro público + fluxo de aprovação no CMS)
// ─────────────────────────────────────────────────────────────

enum InfluencerStatus {
  PENDING
  APPROVED
  REJECTED
}

model Influencer {
  id              String           @id @default(uuid())
  name            String
  email           String           @unique
  whatsapp        String?
  niche           String?
  location        String?
  description     String?          @db.Text
  profileImage    String?
  coverImage      String?
  presentationPdf String?
  // Ex.: { "instagram": "https://...", "tiktok": "...", "youtube": "..." }
  socialNetworks  Json?
  status          InfluencerStatus @default(PENDING)
  showOnShowcase  Boolean          @default(false)
  rejectionReason String?
  reviewedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status, showOnShowcase])
}

// ─────────────────────────────────────────────────────────────
// Conteúdo institucional
// ─────────────────────────────────────────────────────────────

model Article {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  excerpt     String?   @db.Text
  content     String    @db.Text
  coverImage  String?
  category    String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  author      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}

model SuccessCase {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  clientName  String
  segment     String?
  summary     String?  @db.Text
  description String   @db.Text
  coverImage  String?
  images      String[]
  results     String?  @db.Text
  // Ex.: [{ "label": "Alcance", "value": "2,4M" }]
  metrics     Json?
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Service {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  shortDescription String?
  description      String   @db.Text
  icon             String?
  // Pilar do hub: assessoria | producao | influencia (agrupa as entregas no site)
  pillar           String?
  features         String[]
  order            Int      @default(0)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Brand {
  id        String   @id @default(uuid())
  name      String
  logo      String
  // Fundo do cartão do logo no site: light | dark (use dark para logos brancos)
  background String  @default("light")
  website   String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id        String   @id @default(uuid())
  name      String
  role      String
  bio       String?  @db.Text
  photo     String?
  instagram String?
  linkedin  String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Contato e orçamento
// ─────────────────────────────────────────────────────────────

enum ContactType {
  GENERAL
  BUDGET
}

enum ContactStatus {
  NEW
  IN_PROGRESS
  DONE
}

model ContactRequest {
  id              String        @id @default(uuid())
  name            String
  email           String
  phone           String?
  company         String?
  message         String        @db.Text
  type            ContactType   @default(GENERAL)
  status          ContactStatus @default(NEW)
  serviceInterest String?
  budgetRange     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, createdAt])
}

// Depoimentos em vídeo exibidos na página inicial (vídeo hospedado no YouTube).
model Testimonial {
  id          String   @id @default(uuid())
  // Pessoa que dá o depoimento
  clientName  String
  role        String?
  company     String
  // Frase de destaque exibida no cartão
  quote       String   @db.Text
  // Fonte do vídeo: UMA das duas. YouTube (só o ID; o link é montado no site) ou arquivo enviado.
  youtubeId   String?
  videoFile   String?
  photo       String?
  // vertical (9:16, Shorts) | horizontal (16:9)
  orientation String   @default("vertical")
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
