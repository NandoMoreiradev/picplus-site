// PicPlus — schema do banco de dados (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Administração
// ─────────────────────────────────────────────────────────────

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  password          String
  name              String
  // Foto de perfil (URL do arquivo no storage). Aparece só no painel.
  avatarUrl         String?
  // Proprietário: tem todas as permissões, independentemente do cargo, e não pode ficar sem ninguém.
  isOwner           Boolean           @default(false)
  // Usuário desativado não consegue entrar e tem a sessão invalidada.
  active            Boolean           @default(true)
  // Recuperação de senha: guarda só o hash (SHA-256) do token enviado por e-mail.
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  role              Role?             @relation(fields: [roleId], references: [id], onDelete: SetNull)
  roleId            String?
  articles          Article[]
  // Gestão de tarefas
  tasksAssigned     Task[]            @relation("TaskAssignedTo")
  tasksCreated      Task[]            @relation("TaskCreatedBy")
  taskCoAssignments TaskAssignee[]    @relation("TaskCoAssignee")
  taskProjects      TaskProject[]     @relation("TaskProjectOwner")
  taskComments      TaskComment[]     @relation("TaskCommentAuthor")
  taskAttachments    TaskAttachment[]  @relation("TaskAttachmentUploader")
  taskActivities     TaskActivityLog[] @relation("TaskActivityUser")
  enrollmentsGranted Enrollment[]      @relation("EnrollmentGrantedBy")
  lessonComments     LessonComment[]   @relation("LessonCommentAdmin")
  emailTemplates     EmailTemplate[]   @relation("EmailTemplateCreator")
  clientsManaged     Client[]          @relation("ClientAccountManager")
  clientNotes        ClientNote[]      @relation("ClientNoteAuthor")
  // WhatsApp e Atendimento
  whatsappConversationsAssigned WhatsappConversation[] @relation("ConversationAssignedTo")
  whatsappMessagesSent          WhatsappMessage[]      @relation("SentByUser")
  whatsappNotesCreated          WhatsappConversationNote[] @relation("NoteAuthor")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([roleId])
}

// Cargo = conjunto de permissões no formato "recurso.acao" (ver src/access/permissions.ts).
model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Influenciadores (cadastro público + fluxo de aprovação no CMS)
// ─────────────────────────────────────────────────────────────

enum InfluencerStatus {
  PENDING
  APPROVED
  REJECTED
}

model Influencer {
  id              String           @id @default(uuid())
  name            String
  email           String           @unique
  whatsapp        String?
  niche           String?
  location        String?
  description     String?          @db.Text
  profileImage    String?
  coverImage      String?
  presentationPdf String?
  // Ex.: { "instagram": "https://...", "tiktok": "...", "youtube": "..." }
  socialNetworks  Json?
  totalFollowers  Int?             @default(0)
  impressions     Int?             @default(0)
  status          InfluencerStatus @default(PENDING)
  showOnShowcase  Boolean          @default(false)
  rejectionReason String?
  reviewedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status, showOnShowcase])
}

// ─────────────────────────────────────────────────────────────
// Conteúdo institucional
// ─────────────────────────────────────────────────────────────

model Article {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  excerpt     String?   @db.Text
  content     String    @db.Text
  coverImage  String?
  category    String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  author      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}

model SuccessCase {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  clientName  String
  segment     String?
  summary     String?  @db.Text
  description String   @db.Text
  coverImage  String?
  images      String[]
  // Vídeo opcional: UMA das duas fontes (ou nenhuma). YouTube (só o ID) ou arquivo enviado.
  youtubeId   String?
  videoFile   String?
  results     String?  @db.Text
  // Ex.: [{ "label": "Alcance", "value": "2,4M" }]
  metrics     Json?
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Service {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  shortDescription String?
  description      String   @db.Text
  icon             String?
  // Pilar do hub: assessoria | producao | influencia (agrupa as entregas no site)
  pillar           String?
  features         String[]
  order            Int      @default(0)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Brand {
  id         String   @id @default(uuid())
  name       String
  logo       String
  // Fundo do cartão do logo no site: light | dark (use dark para logos brancos)
  background String   @default("light")
  website    String?
  order      Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TeamMember {
  id        String   @id @default(uuid())
  name      String
  role      String
  bio       String?  @db.Text
  photo     String?
  instagram String?
  linkedin  String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Contato e orçamento
// ─────────────────────────────────────────────────────────────

enum ContactType {
  GENERAL
  BUDGET
}

enum ContactStatus {
  NEW
  IN_PROGRESS
  DONE
}

model ContactRequest {
  id              String        @id @default(uuid())
  name            String
  email           String
  phone           String?
  company         String?
  message         String        @db.Text
  type            ContactType   @default(GENERAL)
  status          ContactStatus @default(NEW)
  serviceInterest String?
  budgetRange     String?
  whatsappContacts WhatsappContact[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, createdAt])
}

// Depoimentos em vídeo exibidos na página inicial (vídeo hospedado no YouTube).
model Testimonial {
  id          String   @id @default(uuid())
  // Pessoa que dá o depoimento
  clientName  String
  role        String?
  company     String
  // Frase de destaque exibida no cartão
  quote       String   @db.Text
  // Fonte do vídeo: UMA das duas. YouTube (só o ID; o link é montado no site) ou arquivo enviado.
  youtubeId   String?
  videoFile   String?
  photo       String?
  // vertical (9:16, Shorts) | horizontal (16:9)
  orientation String   @default("vertical")
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Configurações gerais do site: uma única linha (id "default").
model SiteSettings {
  id          String   @id @default("default")
  // Imagem de compartilhamento (Open Graph, 1200x630) do site e fallback de páginas sem imagem própria
  ogImage     String?
  // Imagem de compartilhamento da listagem do blog (se vazia, usa ogImage)
  blogOgImage String?
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Gestão de tarefas (painel)
// ─────────────────────────────────────────────────────────────

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskActivityAction {
  CREATED
  UPDATED
  DELETED
  RESTORED
  COMPLETED
  REOPENED
  COMMENT_ADDED
  ATTACHMENT_ADDED
  SUBTASK_ADDED
}

// Todo projeto tem os próprios estágios (as colunas do Kanban).
// Excluir um projeto o leva à lixeira junto com as tarefas (mesmo deletedAt), e restaurar devolve tudo.
model TaskProject {
  id           String        @id @default(uuid())
  name         String
  description  String?       @db.Text
  color        String        @default("#B6E829")
  status       ProjectStatus @default(ACTIVE)
  startDate    DateTime?
  endDate      DateTime?
  isPinned     Boolean       @default(false)
  displayOrder Int           @default(0)
  owner        User?         @relation("TaskProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId      String?
  client       Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId     String?
  stages       TaskStage[]
  tasks        Task[]
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([deletedAt])
  @@index([ownerId])
  @@index([clientId])
}

model TaskStage {
  id          String      @id @default(uuid())
  name        String
  color       String      @default("#737373")
  order       Int         @default(0)
  // Tarefas que entram em um estágio "concluído" são marcadas como concluídas.
  isCompleted Boolean     @default(false)
  project     TaskProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  tasks       Task[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([projectId, order])
}

model TaskTag {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String   @default("#737373")
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Subtarefas (itens de checklist) são tarefas com parentTaskId: pertencem à tarefa-pai e não aparecem nas listagens.
model Task {
  id               String            @id @default(uuid())
  title            String
  // HTML gerado pelo editor de texto.
  description      String?           @db.Text
  priority         TaskPriority      @default(MEDIUM)
  startDate        DateTime?
  dueDate          DateTime?
  // Preenchido ao concluir (estágio concluído ou checklist marcado); nulo = em aberto.
  completedAt      DateTime?
  // Posição manual dentro da coluna do Kanban.
  order            Int               @default(0)
  estimatedMinutes Int?
  project          TaskProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId        String
  stage            TaskStage         @relation(fields: [stageId], references: [id], onDelete: NoAction)
  stageId          String
  assignedTo       User?             @relation("TaskAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId     String?
  createdBy        User?             @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById      String?
  coAssignees      TaskAssignee[]
  tags             TaskTag[]
  parentTask       Task?             @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  parentTaskId     String?
  subtasks         Task[]            @relation("TaskSubtasks")
  comments         TaskComment[]
  attachments      TaskAttachment[]
  activities       TaskActivityLog[]
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([projectId, stageId, order])
  @@index([assignedToId])
  @@index([parentTaskId])
  @@index([dueDate])
  @@index([deletedAt])
}

model TaskAssignee {
  id        String   @id @default(uuid())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String
  user      User     @relation("TaskCoAssignee", fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([taskId, userId])
  @@index([userId])
}

model TaskComment {
  id              String        @id @default(uuid())
  // HTML gerado pelo editor de texto.
  content         String        @db.Text
  // Áudio gravado no comentário (opcional): arquivo no armazenamento, tipo e duração em segundos.
  audioUrl        String?
  audioMime       String?
  audioDuration   Int?
  task            Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId          String
  user            User?         @relation("TaskCommentAuthor", fields: [userId], references: [id], onDelete: SetNull)
  userId          String?
  // Respostas em fio: o comentário "pai" ao qual este responde.
  parentComment   TaskComment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  parentCommentId String?
  replies         TaskComment[] @relation("CommentReplies")
  isEdited        Boolean       @default(false)
  isDeleted       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([taskId, createdAt])
  @@index([parentCommentId])
}

model TaskAttachment {
  id           String   @id @default(uuid())
  fileName     String
  fileType     String
  fileSize     Int
  // URL do arquivo no armazenamento.
  url          String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId       String
  uploadedBy   User?    @relation("TaskAttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([taskId])
}

model TaskActivityLog {
  id          String             @id @default(uuid())
  action      TaskActivityAction
  description String?
  // Antes/depois de cada campo alterado: { campo: { old, new } }.
  changes     Json?
  task        Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId      String
  user        User?              @relation("TaskActivityUser", fields: [userId], references: [id], onDelete: SetNull)
  userId      String?
  createdAt   DateTime           @default(now())

  @@index([taskId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Templates de E-mail (inspirado no Maskot Edu)
// ─────────────────────────────────────────────────────────────

enum EmailTriggerType {
  ACADEMY_WELCOME
  ACADEMY_PURCHASE_APPROVED
  ACADEMY_ADMIN_GRANT
  ACADEMY_CERTIFICATE_ISSUED
  ACADEMY_COMMENT_REPLY
  ACADEMY_PASSWORD_RESET
  INFLUENCER_RECEIVED
  INFLUENCER_APPROVED
  INFLUENCER_REJECTED
  CONTACT_RECEIVED
  ADMIN_WELCOME
  ADMIN_PASSWORD_RESET
  ACADEMY_PAYMENT_PENDING
  ACADEMY_PAYMENT_REJECTED
  ACADEMY_REFUNDED
}

model EmailTemplate {
  id          String            @id @default(uuid())
  name        String
  subject     String
  trigger     EmailTriggerType? @unique
  // HTML renderizado (usado no disparo real ou quando não há designJson).
  body        String            @db.Text
  // Estrutura de blocos e configurações visuais do construtor de e-mails.
  designJson  Json?
  active      Boolean           @default(true)
  createdBy   User?             @relation("EmailTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([trigger])
}

// ─────────────────────────────────────────────────────────────
// PicPlus Academy (cursos, alunos, vendas, progresso e certificados)
// ─────────────────────────────────────────────────────────────

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum LessonVideoProvider {
  YOUTUBE
  VIMEO
  PANDA
  UPLOAD
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED_CENTS
}

enum CourseOrderStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
  CANCELED
}

enum EnrollmentSource {
  PURCHASE
  ADMIN_GRANT
  FREE_COURSE
}

enum EnrollmentStatus {
  ACTIVE
  REVOKED
}

model Student {
  id                  String          @id @default(uuid())
  name                String
  email               String          @unique
  password            String
  cpf                 String?
  phone               String?
  avatarUrl           String?
  active              Boolean         @default(true)
  resetToken          String?
  resetTokenExpiresAt DateTime?
  orders              CourseOrder[]
  enrollments         Enrollment[]
  comments            LessonComment[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model Course {
  id                  String          @id @default(uuid())
  title               String
  slug                String          @unique
  subtitle            String?
  description         String          @db.Text
  coverImage          String?
  promoVideoUrl       String?
  instructorName      String
  instructorBio       String?         @db.Text
  instructorAvatar    String?
  // Valores monetários em centavos (ex.: 29700 = R$ 297,00).
  priceCents          Int             @default(0)
  compareAtPriceCents Int?
  workloadHours       Int             @default(1)
  level               CourseLevel     @default(BEGINNER)
  category            String?
  features            String[]
  published           Boolean         @default(false)
  featured            Boolean         @default(false)
  order               Int             @default(0)
  modules             CourseModule[]
  orders              CourseOrder[]
  enrollments         Enrollment[]
  coupons             AcademyCoupon[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([published, order])
}

model CourseModule {
  id          String         @id @default(uuid())
  title       String
  description String?
  order       Int            @default(0)
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId    String
  lessons     CourseLesson[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([courseId, order])
}

model CourseLesson {
  id              String              @id @default(uuid())
  title           String
  description     String?             @db.Text
  videoProvider   LessonVideoProvider @default(YOUTUBE)
  videoUrl        String?
  durationSeconds Int                 @default(0)
  isFreePreview   Boolean             @default(false)
  published       Boolean             @default(true)
  order           Int                 @default(0)
  module          CourseModule        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId        String
  materials       LessonMaterial[]
  progress        LessonProgress[]
  comments        LessonComment[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([moduleId, order])
}

model LessonMaterial {
  id        String       @id @default(uuid())
  title     String
  fileUrl   String
  fileName  String
  fileSize  Int          @default(0)
  fileType  String       @default("application/pdf")
  order     Int          @default(0)
  lesson    CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId  String
  createdAt DateTime     @default(now())

  @@index([lessonId, order])
}

model AcademyCoupon {
  id            String             @id @default(uuid())
  code          String             @unique
  discountType  CouponDiscountType @default(PERCENTAGE)
  // Se PERCENTAGE: 1 a 100. Se FIXED_CENTS: valor em centavos.
  discountValue Int
  maxUses       Int?
  usedCount     Int                @default(0)
  expiresAt     DateTime?
  active        Boolean            @default(true)
  course        Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  courseId      String?
  orders        CourseOrder[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([code])
}

model CourseOrder {
  id                 String            @id @default(uuid())
  student            Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId          String
  course             Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId           String
  coupon             AcademyCoupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponId           String?
  originalPriceCents Int
  discountCents      Int               @default(0)
  finalPriceCents    Int
  status             CourseOrderStatus @default(PENDING)
  mpPreferenceId     String?
  mpCheckoutUrl      String?
  mpPaymentId        String?           @unique
  mpStatus           String?
  paymentMethod      String?
  paidAt             DateTime?
  enrollment         Enrollment?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([studentId, createdAt])
  @@index([courseId, status])
}

model Enrollment {
  id              String           @id @default(uuid())
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId       String
  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId        String
  order           CourseOrder?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId         String?          @unique
  source          EnrollmentSource @default(PURCHASE)
  grantedBy       User?            @relation("EnrollmentGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  grantedById     String?
  status          EnrollmentStatus @default(ACTIVE)
  completedAt     DateTime?
  certificateCode String?          @unique
  progress        LessonProgress[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([studentId, courseId])
  @@index([courseId, status])
}

model LessonProgress {
  id                  String       @id @default(uuid())
  enrollment          Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  enrollmentId        String
  lesson              CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId            String
  completed           Boolean      @default(false)
  completedAt         DateTime?
  lastPositionSeconds Int          @default(0)
  updatedAt           DateTime     @updatedAt

  @@unique([enrollmentId, lessonId])
  @@index([lessonId])
}

model LessonComment {
  id              String          @id @default(uuid())
  content         String          @db.Text
  lesson          CourseLesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId        String
  student         Student?        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId       String?
  adminUser       User?           @relation("LessonCommentAdmin", fields: [adminUserId], references: [id], onDelete: SetNull)
  adminUserId     String?
  parentComment   LessonComment?  @relation("LessonCommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  parentCommentId String?
  replies         LessonComment[] @relation("LessonCommentReplies")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([lessonId, createdAt])
  @@index([parentCommentId])
}


// ─────────────────────────────────────────────────────────────
// Gestão de Clientes da Agência & Integração Asaas v3
// ─────────────────────────────────────────────────────────────

enum ClientStatus {
  PROSPECT
  ONBOARDING
  ACTIVE
  PAUSED
  CHURNED
}

enum ContractType {
  RETAINER_FEE
  FIXED_SCOPE
  ON_DEMAND
}

enum ChargeBillingType {
  BOLETO
  PIX
  CREDIT_CARD
  UNDEFINED
}

enum ChargeStatus {
  PENDING
  RECEIVED
  CONFIRMED
  OVERDUE
  REFUNDED
  CANCELED
}

model Client {
  id                String          @id @default(uuid())
  corporateName     String
  tradeName         String
  cnpjCpf           String          @unique
  stateRegistration String?
  segment           String?
  website           String?
  status            ClientStatus    @default(ACTIVE)

  // Endereço fiscal completo (exigido pelo Asaas para emissão de boleto/NF)
  postalCode        String?
  address           String?
  addressNumber     String?
  complement        String?
  neighborhood      String?
  city              String?
  state             String?

  // Dados Financeiros & Parâmetros do Contrato
  contractType      ContractType    @default(RETAINER_FEE)
  monthlyFeeCents   Int?            @default(0)
  dueDay            Int?            @default(10)
  contractStart     DateTime?
  contractEnd       DateTime?

  // Chaves de Integração Externa (Asaas v3)
  asaasCustomerId   String?         @unique

  // Responsável na Agência (Account Manager / Atendimento)
  accountManager    User?           @relation("ClientAccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)
  accountManagerId  String?

  // Relacionamentos operacionais
  contacts          ClientContact[]
  projects          TaskProject[]
  charges           ClientCharge[]
  notes             ClientNote[]
  whatsappContacts  WhatsappContact[]

  deletedAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([status])
  @@index([accountManagerId])
  @@index([deletedAt])
}

model ClientContact {
  id          String   @id @default(uuid())
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
  name        String
  role        String?
  email       String
  phone       String?
  whatsapp    String?
  isFinancial Boolean  @default(false)
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
}

model ClientCharge {
  id             String            @id @default(uuid())
  client         Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId       String
  description    String
  valueCents     Int
  dueDate        DateTime
  billingType    ChargeBillingType @default(UNDEFINED)
  status         ChargeStatus      @default(PENDING)

  // Integração Asaas v3
  asaasPaymentId String?           @unique
  invoiceUrl     String?
  bankSlipUrl    String?
  pixQrCodeUrl   String?
  pixPayload     String?           @db.Text
  paidAt         DateTime?

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([clientId, status])
  @@index([dueDate])
}

model ClientNote {
  id        String   @id @default(uuid())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  author    User?    @relation("ClientNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorId  String?
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([clientId])
}

// ─────────────────────────────────────────────────────────────
// WhatsApp & Chatbot com IA
// ─────────────────────────────────────────────────────────────

enum WhatsappConversationStatus {
  BOT_HANDLING
  OPEN
  RESOLVED
}

enum WhatsappMessageDirection {
  INBOUND
  OUTBOUND
}

enum WhatsappMessageType {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  STICKER
  TEMPLATE
  INTERACTIVE
  SYSTEM
}

enum WhatsappMessageStatus {
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model WhatsappChannel {
  id              String    @id @default(uuid())
  phoneNumberId   String    @unique
  wabaId          String
  phoneNumber     String
  accessToken     String    @db.Text
  verifyToken     String    @default("picplus_secret_verify_token")
  isActive        Boolean   @default(true)
  qualityRating   String?   @default("GREEN")
  aboutText       String?
  profilePhotoUrl String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model WhatsappContact {
  id               String                 @id @default(uuid())
  waId             String                 @unique // Telefone E.164 sem "+" (ex: 5511999999999)
  phoneNumber      String?
  profileName      String
  isBlocked        Boolean                @default(false)
  
  clientId         String?
  client           Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull)

  contactRequestId String?
  contactRequest   ContactRequest?        @relation(fields: [contactRequestId], references: [id], onDelete: SetNull)

  conversations    WhatsappConversation[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([waId])
  @@index([clientId])
  @@index([contactRequestId])
}

model WhatsappConversation {
  id               String                     @id @default(uuid())
  status           WhatsappConversationStatus @default(BOT_HANDLING)
  lastMessageAt    DateTime                   @default(now())
  lastSeq          Int                        @default(0)
  resolutionReason String?
  
  contactId        String
  contact          WhatsappContact            @relation(fields: [contactId], references: [id], onDelete: Cascade)

  assignedUserId   String?
  assignedUser     User?                      @relation("ConversationAssignedTo", fields: [assignedUserId], references: [id], onDelete: SetNull)

  notes            WhatsappConversationNote[]
  messages         WhatsappMessage[]

  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@index([status])
  @@index([contactId])
  @@index([assignedUserId])
  @@index([lastMessageAt])
}

model WhatsappMessage {
  id               String                   @id @default(uuid())
  wamid            String?                  @unique // ID da mensagem no WhatsApp (wamid.HBgL...)
  direction        WhatsappMessageDirection
  type             WhatsappMessageType      @default(TEXT)
  content          String?                  @db.Text
  status           WhatsappMessageStatus    @default(SENT)
  sentAt           DateTime                 @default(now())
  deliveredAt      DateTime?
  readAt           DateTime?
  errorMessage     String?
  mediaUrl         String?
  mimeType         String?
  fileName         String?
  
  conversationId   String
  conversation     WhatsappConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  sentByUserId     String?
  sentByUser       User?                    @relation("SentByUser", fields: [sentByUserId], references: [id], onDelete: SetNull)

  replyToMessageId String?
  replyToMessage   WhatsappMessage?         @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          WhatsappMessage[]        @relation("MessageReplies")

  createdAt        DateTime                 @default(now())

  @@index([conversationId])
  @@index([conversationId, sentAt])
  @@index([wamid])
}

model WhatsappConversationNote {
  id             String               @id @default(uuid())
  content        String               @db.Text
  conversationId String
  conversation   WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String?
  author         User?                @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  isAiGenerated  Boolean              @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([conversationId])
}

model AiChatbotConfig {
  id                         String   @id @default("default")
  isActive                   Boolean  @default(true)
  personaName                String   @default("Cloe")
  systemPrompt               String   @db.Text
  geminiModel                String   @default("gemini-3.8-flash")
  geminiApiKey               String?  @db.Text
  temperature                Float    @default(0.7)
  autoHandoff                Boolean  @default(true)
  autoHandoffKeywords        String[] @default(["atendente", "humano", "atendimento", "pessoa", "falar com"])
  maxMessagesBeforeHandoff   Int      @default(15)
  businessHoursOnly          Boolean  @default(false)
  updatedAt                  DateTime @updatedAt
  createdAt                  DateTime @default(now())
}

