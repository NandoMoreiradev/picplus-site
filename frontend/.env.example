# URL base da API (sem /api no final)
VITE_API_URL=http://localhost:3000

# Dados de contato exibidos no site (deixe vazio para ocultar)
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
# Somente dígitos com DDI+DDD, ex.: 5511999999999. Vazio = usa o número padrão da agência (79 98839-0389)
VITE_WHATSAPP=
VITE_ADDRESS=

# Redes sociais da agência (URLs completas; vazio oculta o ícone)
# Instagram vazio = usa o perfil padrão da agência (instagram.com/picpluscompany)
VITE_INSTAGRAM=
VITE_TIKTOK=
VITE_YOUTUBE=
VITE_LINKEDIN=

# URL pública do site (canonical, Open Graph)
VITE_SITE_URL=https://picpluscompany.com.br
